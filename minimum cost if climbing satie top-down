public class Main{
    static int[] dp;
    /**
     * Top-Down DP (Memoization) approach for Min Cost Climbing Stairs.
     *
     * - At each step, we can move either 1 or 2 steps ahead.
     * - To reach the top, we must pay the cost of the current step.
     * - dp[i] stores the minimum cost required to reach the top starting from step i.
     *
     * Recurrence:
     * dp[i] = cost[i] + min(dp[i+1], dp[i+2])
     *
     * Final Answer:
     * We can start from either step 0 or step 1.
     * Therefore:
     * min(minCost(0), minCost(1))
     *
     * Time Complexity: O(n)
     * - Each state is computed only once.
     *
     * Space Complexity: O(n)
     * - dp array + recursion stack.
     */
    public static int minCost(int[] cost, int i) {
        if(i>=cost.length){
            return 0;
        }
        if(dp[i]!=-1){ 
            return dp[i];
        }
        return dp[i]=cost[i]+Math.min(minCost(cost,i+1),minCost(cost,i+2));
    }
    public static void main(String[] args){
        Scanner sc=new Scanner(System.in);
        int n=sc.nextInt();
        int[] cost=new int[n];
        dp=new int[cost.length];
        Arrays.fill(dp,-1);
        return Math.min(minCost(cost,0),minCost(cost,1));
    }
}
