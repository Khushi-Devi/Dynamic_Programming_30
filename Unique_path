import java.util.*;

public class Main{
    /**
     * Bottom-Up DP (Tabulation) approach for Unique Paths.
     * - arr[i][j] represents the number of ways to reach cell (i, j).
     * - Base case: first row and first column have only 1 way (straight line).
     * - Transition: arr[i][j] = arr[i-1][j] + arr[i][j-1].
     * 
     * Time Complexity: O(m * n)
     * Space Complexity: O(m * n)
     */
    public static int uniquePaths(int m,int n) {
        int[][] arr=new int[m][n];
        for(int i =0; i< m;i++){
            for(int j = 0; j < n; j++){
                if (i == 0 || j == 0) {
                    arr[i][j]=1; // only one way to reach first row/col
                } else {
                    arr[i][j]=arr[i-1][j]+arr[i][j-1];
                }
            }
        }
    return arr[m-1][n-1];
    }
    public static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int m=sc.nextInt();
        int n=sc.nextInt();

        System.out.println("Unique paths in " + m + "x"+n + " grid: "+uniquePaths(m,n));
    }
}
