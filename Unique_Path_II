import java.util.*;
public class Main {
    /**
     * Bottom-Up DP (Tabulation) approach for Unique Paths with Obstacles.
     * - arr[i][j] represents the number of ways to reach cell (i, j).
     * - If a cell has an obstacle, ways = 0.
     * - Base cases: first row and first column must be initialized carefully:
     *   - If obstacle found, all cells after it in that row/col are unreachable.
     * - Transition: arr[i][j] = arr[i-1][j] + arr[i][j-1] if no obstacle.
     * 
     * Time Complexity: O(m * n)
     * Space Complexity: O(m * n)
     */
    public static int uniquePathsWithObstacles(int[][] grid) {
        int r=grid.length;
        int c=grid[0].length;

        //If start or end is blocked, no path exists
        if(grid[0][0]==1) return 0;
        //Initialize start
        grid[0][0]=1;
        // First column
        for(int i =1; i <r; i++){
            grid[i][0] = (grid[i][0]==0 && grid[i-1][0]== 1)?1 :0;
        }
        // First row
        for(int j = 1; j < c; j++) {
            grid[0][j] = (grid[0][j]==0 && grid[0][j - 1]==1) ? 1 : 0;
        }
        // Fill rest of the grid
        for(int i=1; i<r;i++){
            for(int j=1;j<c;j++){
                if(grid[i][j] == 1){
                    grid[i][j] = 0; // obstacle
                } 
                else{
                    grid[i][j]=grid[i-1][j] + grid[i][j-1];
                }
            }
        }
        return grid[r-1][c-1];
    }

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int m=sc.nextInt();
        int n=sc.nextInt();

        int[][] grid = new int[m][n];
        for(int i = 0; i < m; i++) {
            for (int j = 0; j < n; j++) {
                grid[i][j] = sc.nextInt(); // 0 for empty, 1 for obstacle
            }
        }
        System.out.println("unique paths with obstacles: " + uniquePathsWithObstacles(grid));
    }
}
