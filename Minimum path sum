import java.util.*;

public class Main {

    /**
     * Bottom-Up DP (Tabulation) approach for Minimum Path Sum.
     *
     * - arr[i][j] represents the minimum cost required
     *   to reach cell (i, j) from (0, 0).
     *
     * - Base case:
     *   arr[0][0] = grid[0][0]
     *
     * - First row:
     *   Can only come from the left.
     *
     * - First column:
     *   Can only come from above.
     *
     * - Transition:
     *   arr[i][j] = grid[i][j] +
     *               min(arr[i-1][j], arr[i][j-1])
     *
     * Time Complexity: O(m * n)
     * Space Complexity: O(m * n)
     */
    public static int minPathSum(int[][] grid) {

        int n = grid.length;
        int m = grid[0].length;

        int[][] arr = new int[n][m];

        // Starting cell
        arr[0][0] = grid[0][0];

        // Fill first row
        for (int j = 1; j < m; j++) {
            arr[0][j] = grid[0][j] + arr[0][j - 1];
        }

        // Fill first column
        for (int i = 1; i < n; i++) {
            arr[i][0] = grid[i][0] + arr[i - 1][0];
        }

        // Fill remaining cells
        for (int i = 1; i < n; i++) {
            for (int j = 1; j < m; j++) {
                arr[i][j] = grid[i][j]
                        + Math.min(arr[i - 1][j], arr[i][j - 1]);
            }
        }

        return arr[n - 1][m - 1];
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);

        int rows = sc.nextInt();
        int cols = sc.nextInt();

        int[][] grid = new int[rows][cols];

        for (int i = 0; i < rows; i++) {
            for (int j = 0; j < cols; j++) {
                grid[i][j] = sc.nextInt();
            }
        }

        System.out.println("Minimum Path Sum: " + minPathSum(grid));
    }
}
