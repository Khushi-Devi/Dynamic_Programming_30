import java.util.*;

public class Main {

    /**
     * Bottom-Up DP (Tabulation) approach for Min Cost Climbing Stairs.
     *
     * - dp[i] represents the minimum cost required
     *   to reach stair i.
     *
     * - From any stair, we can climb either:
     *      1 step
     *      2 steps
     *
     * - Base Cases:
     *   dp[0] = cost[0]
     *   dp[1] = cost[1]
     *
     * - Transition:
     *   dp[i] = cost[i] +
     *           min(dp[i-1], dp[i-2])
     *
     * - The top floor is beyond the last stair.
     *   We can reach it either from:
     *      stair n-1
     *      stair n-2
     *
     * - Therefore:
     *   answer = min(dp[n-1], dp[n-2])
     *
     * Time Complexity: O(n)
     * Space Complexity: O(n)
     */
    public static int minCostClimbingStairs(int[] cost) {
        int n = cost.length;
        int[] dp = new int[n];
        dp[0] = cost[0];
        dp[1] = cost[1];
        for (int i = 2; i < n; i++) {
            dp[i] = cost[i] +
                    Math.min(dp[i - 1], dp[i - 2]);
        }
        return Math.min(dp[n - 1], dp[n - 2]);
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] cost = new int[n];
        for (int i = 0; i < n; i++) {
            cost[i] = sc.nextInt();
        }
        System.out.println("Minimum Cost: "+ minCostClimbingStairs(cost));
    }
}
