import java.util.*;

public class Main{

    /**
     * Bottom-Up DP (Tabulation) approach.
     * - Iteratively compute ways(i) = ways(i-1) + ways(i-2).
     * - Build the dp[] array from base cases up to n.
     * 
     * Time Complexity: O(n)
     * - Single loop from 2 to n.
     * 
     * Space Complexity: O(n)
     * - dp[] array of size n+1.
     * - Can be optimized to O(1) by storing only the last two values.
     */

    public static void main(String[] args){
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();

        int[] dp = new int[n+2];
        dp[0]=1;
        dp[1]=1;

        for(int i=2;i<=n;i++){
            dp[i]=dp[i-1]+dp[i-2];
        }
        System.out.println(dp[n]);
    }
}
